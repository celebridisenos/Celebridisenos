{
  "name": "CelebriDiseños",
  "short_name": "CelebriDiseños",
  "description": "Pedidos, clientes, productos, tareas, noticias y redes de CelebriDiseños",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f6f5fb",
  "theme_color": "#7c3aed",
  "orientation": "any",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pedidos", "url": "./#/pedidos", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tareas", "url": "./#/tareas", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nueva foto", "url": "./#/archivos/subir", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
